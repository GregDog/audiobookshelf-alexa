# Copy to .env (or configure as Lambda environment variables)
# and fill in the values for your audiobookshelf instance.

# Public HTTPS base URL of your audiobookshelf server.
# Must be reachable from the public internet (Alexa fetches stream URLs
# directly from this server). No trailing slash.
ABS_BASE_URL=https://abs.example.com

# Long-lived API key created via Settings -> Users -> API Keys
# in the audiobookshelf web UI. Used as a Bearer token.
ABS_API_KEY=eyJhbGciOi...

# Optional: id of the library to use by default. If unset, the first
# library returned by /api/libraries is used.
# ABS_DEFAULT_LIBRARY_ID=
